# Robinhood Chain explorer (Blockscout). Chain id 4663.
EXPLORER_API=https://robinhoodchain.blockscout.com/api/v2
# Postgres (Railway/Neon/Supabase give you this string)
DATABASE_URL=postgres://user:pass@host:5432/lowtide
PORT=8080
# Launchpad factory addresses on Robinhood Chain. Fill from each platform's docs/explorer.
# Detection also falls back to bytecode fingerprints, so these are an accelerator, not a requirement.
PONS_V1_FACTORY=
PONS_V2_FACTORY=
HOODFUN_FACTORY=
POOLS_TRADE_FACTORY=
# Uniswap on Robinhood Chain
UNISWAP_V3_FACTORY=
UNISWAP_V4_POOL_MANAGER=
# Indexer poll interval (ms)
POLL_MS=15000
